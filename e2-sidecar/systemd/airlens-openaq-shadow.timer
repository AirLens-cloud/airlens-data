[Unit]
Description=AirLens OpenAQ global observation shadow timer (hourly)
Documentation=https://github.com/AirLens-cloud/airlens-data/tree/main/e2-sidecar

[Timer]
# Hourly slice. Slots are staggered (:05 sc / :15 openaq) so the two collectors
# never overlap their memory peaks on a 1GB box.
OnCalendar=*-*-* *:15:00
RandomizedDelaySec=0
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
