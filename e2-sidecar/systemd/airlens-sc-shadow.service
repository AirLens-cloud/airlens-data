[Unit]
Description=AirLens Sensor.Community global low-cost sensor shadow (Wave 1 sidecar, global pivot)
Documentation=https://github.com/AirLens-cloud/airlens-data/tree/main/e2-sidecar
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/airlens/sidecar
ExecStart=/usr/local/bin/run-global-shadow.sh sc

# Secrets as files, never as literals (systemd LoadCredential pattern).
LoadCredential=hf_token:/etc/airlens/hf_token

Environment=AIRLENS_ROOT=/opt/airlens
Environment=AIRLENS_SHADOW_OUT=/var/lib/airlens/shadow
Environment=DENO_DIR=/opt/airlens/deno-cache
# hf_hub 1.x xet uploader needs a writable cache; HOME is sealed by ProtectHome.
Environment=HF_HOME=/var/lib/airlens/hf-home

# 1GB box: keep any OOM inside this unit's cgroup (sshd must survive).
MemoryAccounting=yes
MemoryHigh=350M
MemoryMax=400M

# One retry absorbs a transient blip; the next hourly slot is the real retry.
Restart=on-failure
RestartSec=90s
StartLimitBurst=2
TimeoutStartSec=10min

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/airlens /opt/airlens/deno-cache
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
